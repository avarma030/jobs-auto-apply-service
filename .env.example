# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=jobs-auto-apply-service
LOG_LEVEL=INFO
DRY_RUN=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no extra infra required)
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db
# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jobs_db

# ── User Profile ──────────────────────────────────────────────────────────────
USER_PROFILE_PATH=data/user_profile.json
RESUME_PATH=data/resume.pdf
# COVER_LETTER_TEMPLATE_PATH=data/cover_letter_template.txt

# ── Scraping ──────────────────────────────────────────────────────────────────
# Comma-separated board slugs, or "all"
ENABLED_BOARDS=all
SCRAPE_INTERVAL_MINUTES=60
MAX_CONCURRENT_SCRAPERS=3
REQUEST_DELAY_SECONDS=2.0
USE_PROXIES=false
# PROXY_LIST_PATH=data/proxies.txt

# ── Applying ──────────────────────────────────────────────────────────────────
MAX_APPLICATIONS_PER_RUN=50
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_SECONDS=30
SCREENSHOT_ON_FAILURE=true
SCREENSHOTS_DIR=data/screenshots

# ── Redis / Celery (task queue mode) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_TASK_QUEUE=false

# ── Notifications ─────────────────────────────────────────────────────────────
# NOTIFY_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=yourapppassword

# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
